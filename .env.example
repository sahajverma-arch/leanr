# Supabase project settings → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings → Database → Connection string (use the pooler
# connection string for serverless/edge-friendly connections)
DATABASE_URL=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model slug, verified live against https://api.openai.com/v1/models
# (2026-09-08). Replaced NVIDIA NIM, whose 8B-tier model rejected every
# recipe-engine plan on macro tolerance — see CLAUDE.md "The recipe engine".
OPENAI_MODEL=

# Global kill switch for the Meal Archetype layer — set to "false" to force
# archetype selection off everywhere (system behaves exactly as it did
# before this layer existed). Any other value, or unset, means enabled.
ARCHETYPE_SELECTION_ENABLED=true

# Rollout flag for the Dietitian Knowledge RAG layer (see CLAUDE.md
# "Dietitian knowledge layer") — set to "true" to enable. Off by default;
# only takes effect when RECIPE_ENGINE_ENABLED is also on.
DIETITIAN_KNOWLEDGE_ENABLED=false

# Rollout flag for the Diet Plan Examples RAG layer (see CLAUDE.md "Diet
# plan examples layer") — set to "true" to enable. Off by default;
# independent of DIETITIAN_KNOWLEDGE_ENABLED, only takes effect when
# RECIPE_ENGINE_ENABLED is also on.
DIET_PLAN_EXAMPLES_ENABLED=false

# How many independent whole-week attempts the recipe engine makes before
# keeping the best. Default 3: measured latency is ~5-10s per call, so 5
# attempts run ~45-50s, which does not fit Vercel Hobby's 60s function
# ceiling safely; 3 runs ~30s. Set to 0 to restore the original 19-22 call
# per-day-retry path.
RECIPE_BEST_OF_N=5
