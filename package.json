{
  "name": "dietplat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "seed:foods": "tsx --env-file=.env.local src/db/seed-foods.ts",
    "seed:recipes": "tsx --env-file=.env.local src/db/seed-recipes.ts",
    "seed:knowledge": "tsx --env-file=.env.local src/db/seed-knowledge.ts",
    "seed:diet-plan-examples": "tsx --env-file=.env.local src/db/seed-diet-plan-examples.ts",
    "seed:ingredients": "tsx --env-file=.env.local src/db/seed-ingredients.ts",
    "seed:demo": "tsx --env-file=.env.local src/db/seed-demo-clients.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
